# ---------------------------------------------------------------------------
# ClipForge environment. Copy to `.env` and fill in secrets.
# NEVER commit `.env`. The API key is never logged.
# ---------------------------------------------------------------------------

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here

# Transcriber backend: "openai" (API, default) or "local" (faster-whisper)
TRANSCRIBER=openai

# OpenAI models (names are configurable; override as needed).
# CHEAPEST TEST PROFILE (what is set below): gpt-4.1-nano for scoring + titles
# (~$0.10 / $0.40 per 1M tokens). The big cost is transcription ($0.006 per audio
# minute with whisper-1), not tokens: for free test runs set TRANSCRIBER=local.
# For best quality use OPENAI_SCORING_MODEL=gpt-4o-mini, OPENAI_METADATA_MODEL=gpt-4o.
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_SCORING_MODEL=gpt-4.1-nano
OPENAI_METADATA_MODEL=gpt-4.1-nano

# --- Local transcription (used only when TRANSCRIBER=local) ---
LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_COMPUTE_TYPE=int8
LOCAL_WHISPER_DEVICE=auto

# --- Cost control ---
# Hard cap per job in USD. Job stops with a clear error if exceeded.
MAX_JOB_COST_USD=5.0

# --- Infrastructure ---
# Inside Docker Compose these default hostnames (postgres, redis) resolve on the
# compose network. For native dev against the Dockerised DB/Redis use localhost
# with the mapped ports (see docker-compose.yml): 5433 and 6380.
DATABASE_URL=postgresql+psycopg://clipforge:clipforge@postgres:5432/clipforge
REDIS_URL=redis://redis:6379/0

# --- Storage ---
# Local disk root for dev. Swap StorageService for S3 in prod.
STORAGE_PATH=/data/storage

# --- App ---
LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=5368709120   # ~5 GB

# --- Performance tuning (speed-first defaults) ---
TRANSCRIBE_CONCURRENCY=8      # parallel transcription API calls
SCORING_CONCURRENCY=8         # parallel LLM scoring batches
RENDER_CONCURRENCY=4          # parallel full re-encodes, vertical clips (lower to 2 for 4K / low RAM)
COPY_CONCURRENCY=8            # parallel no-re-encode cuts, horizontal clips (light: mostly audio)
RENDER_PRESET=ultrafast       # x264 preset: ultrafast(fastest)|veryfast|fast|medium(best)
MAX_CANDIDATES=120            # cap candidates per platform (bounds scoring time)
REFRAME_SAMPLES=8             # face-detection samples per clip (fewer = faster)
