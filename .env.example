# ---------------------------------------------------------------------------
# ClipForge environment. Copy to `.env` and fill in secrets.
# NEVER commit `.env`. The API key is never logged.
# ---------------------------------------------------------------------------

# --- Transcription (speech -> text with word timings) ---
# Clips are cut on sentence boundaries, and captions (.srt) and titles
# ("Part 12 - <first words>") come from this transcript.
#   openai = OpenAI whisper-1: fast (a 104-min film in a few minutes),
#            ~$0.006 per audio minute (~$0.62 for that film). Needs OPENAI_API_KEY.
#   local  = faster-whisper on this machine: free, slower (~48 min for that film).
TRANSCRIBER=openai

# --- OpenAI (used only when TRANSCRIBER=openai) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_TRANSCRIBE_MODEL=whisper-1

# --- Local transcription (used only when TRANSCRIBER=local) ---
LOCAL_WHISPER_MODEL=large-v3-turbo
LOCAL_WHISPER_BEAM_SIZE=1
LOCAL_WHISPER_COMPUTE_TYPE=int8
LOCAL_WHISPER_DEVICE=auto

# --- Cost control ---
# Hard cap per job in USD. Job stops with a clear error if exceeded.
MAX_JOB_COST_USD=5.0

# --- Infrastructure ---
# Inside Docker Compose these default hostnames (postgres, redis) resolve on the
# compose network. For native dev against the Dockerised DB/Redis use localhost
# with the mapped ports (see docker-compose.yml): 5433 and 6380.
DATABASE_URL=postgresql+psycopg://clipforge:clipforge@postgres:5432/clipforge
REDIS_URL=redis://redis:6379/0

# --- Storage ---
# Local disk root for dev. Swap StorageService for S3 in prod.
STORAGE_PATH=/data/storage

# --- Bucket (Upload to bucket, Bucket tab): AWS S3 or any S3-compatible storage ---
# Empty BUCKET_NAME = not set up; the Bucket tab says so.
# After changing these run: docker compose up -d api
# Keep notes on their own line: text after a value becomes part of it.
# Bucket name and its region code, e.g. ap-south-1 (AWS Mumbai); "auto" for R2.
BUCKET_NAME=
BUCKET_REGION=
# Keys of an IAM user allowed only this bucket (IAM > Users > Security credentials).
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
# Empty for AWS S3. Otherwise the provider's S3 address, e.g.
# https://<account-id>.r2.cloudflarestorage.com
BUCKET_ENDPOINT_URL=
# Folder in the bucket everything goes under.
BUCKET_PREFIX=clipforge
# Public address (public bucket or CDN) for links. Empty = signed links for 7 days.
BUCKET_PUBLIC_URL=

# --- App ---
LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=5368709120   # ~5 GB (also the limit for videos imported from a link)
MAX_AUDIO_UPLOAD_BYTES=209715200  # 200 MB, background-music uploads

# --- Import from a link (YouTube etc.) ---
DOWNLOAD_TIMEOUT_S=10800      # stop a download that runs longer than this (3 h)
URL_PROBE_TIMEOUT_S=45        # how long "Check link" waits for the site
# Optional cookies.txt (Netscape format, exported from your browser) for videos
# that need a login, or if YouTube says "Sign in to confirm you're not a bot".
# Put it in the storage volume, e.g. /data/storage/cookies.txt.
YTDLP_COOKIES_FILE=

# --- Performance tuning (speed-first defaults) ---
TRANSCRIBE_CONCURRENCY=8      # parallel transcription API calls
RENDER_CONCURRENCY=4          # parallel full re-encodes, vertical clips (lower to 2 for 4K / low RAM)
COPY_CONCURRENCY=8            # parallel no-re-encode cuts, horizontal clips (light: mostly audio)
RENDER_PRESET=ultrafast       # x264 preset: ultrafast(fastest)|veryfast|fast|medium(best)
REFRAME_SAMPLES=8             # face-detection samples per clip (fewer = faster)
